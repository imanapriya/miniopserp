# ---- Database -------------------------------------------------------------
# Any PostgreSQL 13+ instance works: local, Docker, RDS, Neon, Supabase, ...
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ops_erp?schema=public"

# Separate database used by the automated test suite. It is TRUNCATEd between
# tests, so never point this at a database that holds real data.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ops_erp_test?schema=public"

# ---- Auth -----------------------------------------------------------------
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
BCRYPT_ROUNDS=10

# ---- HTTP -----------------------------------------------------------------
PORT=3000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:5173"

# Password used by prisma/seed.ts for every demo user.
SEED_PASSWORD="Password@123"
