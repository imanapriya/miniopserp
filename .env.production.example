# ── Production environment variables ──────────────────────────────────────────
# Copy this file to .env.production and fill in every value.
# This file is safe to commit. .env.production must NOT be committed.
#
# Usage:
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (used by the postgres service inside Docker) ────────────────────
POSTGRES_USER=ops_erp_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ops_erp

# ── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_EXPIRES_IN=8h

# ── CORS: the URL your browser will load the frontend from ────────────────────
# If running everything on one server:  http://your-server-ip
# If using a domain:                    https://erp.your-company.com
CORS_ORIGINS=http://your-server-ip-or-domain

# ── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
