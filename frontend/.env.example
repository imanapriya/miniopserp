# Where the browser should send API calls.
# Leave as /api to use the Vite dev proxy (single origin, no CORS).
# Set to a full URL (e.g. https://api.example.com/api) for a deployed frontend.
VITE_API_BASE_URL=/api

# Backend the dev proxy forwards to.
VITE_API_PROXY_TARGET=http://localhost:3000

VITE_PORT=5173
