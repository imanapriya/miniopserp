required":false,"in":"query","schema":{"minimum":1,"maximum":200,"default":25,"allOf":[{"$ref":"#/components/schemas/Object"}]}},{"name":"status","required":false,"in":"query","schema":{"type":"string","enum":["ASSIGNED","IN_PROGRESS","COMPLETED"]}},{"name":"locationId","required":false,"in":"query","schema":{"format":"uuid","type":"string"}},{"name":"assignedToId","required":false,"in":"query","schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"description":""}},"security":[{"bearer":[]}],"summary":"List work orders with live availability and shortage","tags":["Work orders"]}},"/api/work-orders/{id}":{"get":{"operationId":"WorkOrdersController_detail","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"object"}}}}},"security":[{"bearer":[]}],"summary":"Work order detail, including shortage and suggested transfer sources","tags":["Work orders"]}},"/api/work-orders/{id}/status":{"patch":{"description":"ASSIGNED to IN_PROGRESS reserves the required material; IN_PROGRESS to COMPLETED consumes it. Both happen in a single database transaction with the status change.","operationId":"WorkOrdersController_updateStatus","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateWorkOrderStatusDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"object"}}}},"403":{"description":"Sales users cannot progress work orders"},"409":{"description":"Invalid transition, or not enough stock to reserve"}},"security":[{"bearer":[]}],"summary":"Advance the work order","tags":["Work orders"]}},"/api/transfers":{"post":{"operationId":"TransfersController_create","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateTransferDto"}}}},"responses":{"201":{"description":""},"403":{"description":"Sales users cannot move stock between locations"},"409":{"description":"Requested quantity exceeds availability at the source"}},"security":[{"bearer":[]}],"summary":"Raise an internal transfer (status REQUESTED - no stock moves yet)","tags":["Internal transfers"]},"get":{"operationId":"TransfersController_list","parameters":[{"name":"page","required":false,"in":"query","schema":{"minimum":1,"default":1,"allOf":[{"$ref":"#/components/schemas/Object"}]}},{"name":"limit","required":false,"in":"query","schema":{"minimum":1,"maximum":200,"default":25,"allOf":[{"$ref":"#/components/schemas/Object"}]}},{"name":"status","required":false,"in":"query","schema":{"type":"string","enum":["REQUESTED","DISPATCHED","RECEIVED"]}},{"name":"sourceLocationId","required":false,"in":"query","schema":{"format":"uuid","type":"string"}},{"name":"destinationLocationId","required":false,"in":"query","schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"description":""}},"security":[{"bearer":[]}],"summary":"List transfers","tags":["Internal transfers"]}},"/api/transfers/{id}":{"get":{"operationId":"TransfersController_detail","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"security":[{"bearer":[]}],"summary":"Transfer detail","tags":["Internal transfers"]}},"/api/transfers/{id}/dispatch":{"post":{"description":"The destination is NOT credited here. The quantity is in transit until it is received.","operationId":"TransfersController_dispatch","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""},"409":{"description":"Already dispatched, or insufficient stock at the source"}},"security":[{"bearer":[]}],"summary":"Dispatch: reduce source stock","tags":["Internal transfers"]}},"/api/transfers/{id}/receive":{"post":{"description":"Omit the body to receive everything outstanding, or pass a smaller quantity for a partial receipt. Receiving an already-received transfer returns 409.","operationId":"TransfersController_receive","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReceiveTransferDto"}}}},"responses":{"200":{"description":""},"409":{"description":"Not dispatched yet, already received, or quantity exceeds outstanding"}},"security":[{"bearer":[]}],"summary":"Receive: increase destination stock","tags":["Internal transfers"]}},"/api/orders":{"post":{"description":"Pass reserveImmediately=true to allocate stock in the same database transaction.","operationId":"OrdersController_create","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateOrderDto"}}}},"responses":{"201":{"description":""},"403":{"description":"Operations users cannot raise customer orders"},"409":{"description":"Not enough available stock to reserve"}},"security":[{"bearer":[]}],"summary":"Create a customer order (Sales)","tags":["Customer orders"]},"get":{"operationId":"OrdersController_list","parameters":[{"name":"page","required":false,"in":"query","schema":{"minimum":1,"default":1,"allOf":[{"$ref":"#/components/schemas/Object"}]}},{"name":"limit","required":false,"in":"query","schema":{"minimum":1,"maximum":200,"default":25,"allOf":[{"$ref":"#/components/schemas/Object"}]}},{"name":"status","required":false,"in":"query","schema":{"type":"string","enum":["DRAFT","RESERVED","FULFILLED","CANCELLED"]}},{"name":"customerName","required":false,"in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"security":[{"bearer":[]}],"summary":"List customer orders with their lines","tags":["Customer orders"]}},"/api/orders/{id}":{"get":{"operationId":"OrdersController_detail","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"str