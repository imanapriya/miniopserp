"1.0","contact":{}},"tags":[],"servers":[],"components":{"securitySchemes":{"bearer":{"scheme":"bearer","bearerFormat":"JWT","type":"http"}},"schemas":{"LoginDto":{"type":"object","properties":{"email":{"type":"string","format":"email","example":"admin@ops-erp.local"},"password":{"type":"string","minLength":6,"example":"Password@123"}},"required":["email","password"]},"AuthUserDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"email":{"type":"string"},"name":{"type":"string"},"role":{"enum":["ADMIN","OPERATIONS","SALES"],"type":"string"},"locationId":{"type":"string","nullable":true},"locationCode":{"type":"string","nullable":true}},"required":["id","email","name","role"]},"AuthResponseDto":{"type":"object","properties":{"accessToken":{"type":"string","description":"JWT bearer token. Send as `Authorization: Bearer <token>`."},"expiresIn":{"type":"string","example":"8h"},"user":{"$ref":"#/components/schemas/AuthUserDto"}},"required":["accessToken","expiresIn","user"]},"Location":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"code":{"type":"string","example":"WH-A","description":"Short unique code used in the UI and in transfer references"},"name":{"type":"string","example":"Warehouse A - Hyderabad"},"isActive":{"type":"boolean","default":true},"createdAt":{"format":"date-time","type":"string"},"inventory":{"type":"array","items":{"type":"object"}},"workOrders":{"type":"array","items":{"type":"object"}}},"required":["id","code","name","isActive","createdAt","inventory","workOrders"]},"CreateLocationDto":{"type":"object","properties":{"code":{"type":"string","minLength":2,"maxLength":32,"example":"WH-C"},"name":{"type":"string","minLength":2,"maxLength":120,"example":"Warehouse C - Pune"}},"required":["code","name"]},"Category":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"code":{"type":"string","example":"RAW"},"name":{"type":"string","example":"Raw Material"},"createdAt":{"format":"date-time","type":"string"},"items":{"type":"array","items":{"type":"object"}}},"required":["id","code","name","createdAt","items"]},"CreateCategoryDto":{"type":"object","properties":{"code":{"type":"string","minLength":2,"maxLength":32,"example":"PACK"},"name":{"type":"string","minLength":2,"maxLength":120,"example":"Packaging"}},"required":["code","name"]},"CreateItemDto":{"type":"object","properties":{"sku":{"type":"string","minLength":2,"maxLength":64,"example":"BOX-STD-01"},"name":{"type":"string","minLength":2,"maxLength":160,"example":"Standard Carton Box"},"categoryId":{"type":"string","format":"uuid"},"uom":{"type":"string","maxLength":16,"example":"EA","default":"EA"}},"required":["sku","name","categoryId"]},"Item":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"sku":{"type":"string","example":"STL-ROD-12"},"name":{"type":"string","example":"Steel Rod 12mm"},"uom":{"type":"string","example":"EA","description":"Unit of measure"},"categoryId":{"type":"string","format":"uuid"},"isActive":{"type":"boolean","default":true},"createdAt":{"format":"date-time","type":"string"},"category":{"$ref":"#/components/schemas/Category"},"batches":{"type":"array","items":{"type":"object"}},"inventory":{"type":"array","items":{"type":"object"}}},"required":["id","sku","name","uom","categoryId","isActive","createdAt","category","batches","inventory"]},"Batch":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"code":{"type":"string","example":"B-2026-04"},"itemId":{"type":"string","format":"uuid"},"expiryDate":{"type":"string","nullable":true,"format":"date"},"createdAt":{"format":"date-time","type":"string"},"item":{"$ref":"#/components/schemas/Item"},"inventory":{"type":"array","items":{"type":"object"}}},"required":["id","code","itemId","createdAt","item","inventory"]},"CreateBatchDto":{"type":"object","properties":{"itemId":{"type":"string","format":"uuid"},"code":{"type":"string","minLength":1,"maxLength":64,"example":"B-2026-09"},"expiryDate":{"type":"string","example":"2027-06-30"}},"required":["itemId","code"]},"Object":{"type":"object","properties":{}},"StockReceiptDto":{"type":"object","properties":{"itemId":{"type":"string","format":"uuid"},"locationId":{"type":"string","format":"uuid"},"batchId":{"type":"string","format":"uuid","description":"Existing batch. Omit to create/reuse one by code."},"batchCode":{"type":"string","maxLength":64,"example":"B-2026-04","description":"Batch code. Created if it does not exist for this item."},"expiryDate":{"type":"string","example":"2027-01-31","description":"Only used when creating a new batch"},"quantity":{"type":"number","minimum":1,"example":100},"reference":{"type":"string","maxLength":120,"description":"Supply a stable value to make a retried receipt safe to send twice."},"note":{"type":"string","maxLength":255}},"required":["itemId","locationId","quantity"]},"StockAdjustmentDto":{"type":"object","properties":{"inventoryId":{"type":"string","format":"uuid","description":"The inventory bucket to correct"},"delta":{"type":"number","example":-5,"description":"Signed change to physical stock. Negative writes stock off, positive adds it."},"reason":{"type":"string","maxLength":255,"example":"Cycle count correction","description":"Adjustments must always be explained."}},"required":["inventoryId","delta","reason"]},"CreateWorkOrderDto":{"type":"object","properties":{"locationId":{"type":"string","format":"uuid","description":"Where the work happens - material is consumed here"},"itemId":{"type":"string","format":"uuid","description":"Material the job consumes"},"requiredQty":{"type":"number","minimum":1,"example":50},"assignedToId":{"type":"string","format":"uuid","description":"Operations user responsible for the job"},"notes":{"type":"string","maxLength":500}},"required":["locationId","itemId","requiredQty","assignedToId"]},"UpdateWorkOrderStatusDto":{"type":"object","properties":{"status":{"enum":["ASSIGNED","IN_PROGRESS","COMPLETED"],"type":"string","example":"IN_PROGRESS"}},"required":["status"]},"CreateTransferDto":{"type":"object","properties":{"sourceLocationId":{"type":"string","format":"uuid"},"destinationLocationId":{"type":"string","format":"uuid"},"itemId":{"type":"string","format":"uuid"},"batchId":{"type":"string","format":"uuid","description":"Batch being moved - stock is batch-tracked end to end"},"quantity":{"type":"number","minimum":1,"example":20},"workOrderId":{"type":"string","format":"uuid","description":"Work order whose shortage this transfer covers"}},"required":["sourceLocationId","destinationLocationId","itemId","batchId","quantity"]},"ReceiveTransferDto":{"type":"object","properties":{"quantity":{"type":"number","minimum":1,"example":12,"description":"Units actually received. Omit to receive the full outstanding quantity. Supplying less records a partial receipt and leaves the transfer open."}}},"CreateOrderLineDto":{"type":"object","properties":{"itemId":{"type":"string","format":"uuid"},"locationId":{"type":"string","format":"uuid","description":"Location the customer is served from"},"quantity":{"type":"number","minimum":1,"example":40}},"required":["itemId","locationId","quantity"]},"CreateOrderDto":{"type":"object","properties":{"customerName":{"type":"string","minLength":2,"maxLength":160,"example":"Acme Industries"},"lines":{"minItems":1,"type":"array","items":{"$ref":"#/components/schemas/CreateOrderLineDto"}},"reserveImmediately":{"type":"boolean","default":false,"description":"Reserve stock as part of the same transaction that creates the order."}},"required":["customerName","lines"]}}}}