                "receipt"
              ]
            },
            "description": "Send this TWICE \u2014 the second attempt returns 409 because `reference` makes it idempotent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"locationId\": \"{{locationA}}\",\n  \"batchId\": \"{{batchId}}\",\n  \"quantity\": 100,\n  \"reference\": \"GRN-DEMO-001\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Receive stock again (expect 409 duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{opsToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventory/receipt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
