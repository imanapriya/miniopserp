            "url": {
              "raw": "{{baseUrl}}/inventory?locationId={{locationA}}&itemId={{itemId}}&q=&outOfStock=false&page=1&limit=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory"
              ],
              "query": [
                {
                  "key": "locationId",
                  "value": "{{locationA}}",
                  "disabled": true
                },
                {
                  "key": "itemId",
                  "value": "{{itemId}}",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "outOfStock",
                  "value": "false",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "25",
                  "disabled": true
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data.length) pm.collectionVariables.set('inventoryId', b.data[0].id);",
                  "pm.test('available = physical - reserved', () => b.data.forEach(r =>",
                  "  pm.expect(r.availableQty).to.eql(r.physicalQty - r.reservedQty)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Receive stock",
          "request": {
            "method": "POST",
            "header": [
